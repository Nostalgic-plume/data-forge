# ============================================================
# DataForge 配置模板 —— 复制为 .env 填写（.env 已 gitignore）
# 凭证一律走环境变量，不写进代码/仓库
# ============================================================

# ---- 模型（主备双链路，按角色分模型）----
# 主模型（生成/修正，成本优先）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 备用模型（故障自动 failover）
LLM_BACKUP_API_KEY=sk-xxx
LLM_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BACKUP_MODEL=qwen-flash

# 分析 agent（质量优先，可复用主 key 或单独）
LLM_ANALYSIS_MODEL=deepseek-v4-pro

# ---- 数据库（目标库 + staging 工作库）----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxx

# ---- staging 工作库命名约定 ----
STAGING_SUFFIX=_staging

# ---- MCP（P6 分析 agent 用）----
MCP_MYSQL_SERVER=mysql-mcp
MCP_FILESYSTEM_ROOT=/path/to/projects

# ---- 生成参数（默认值，GUI 可覆盖）----
DEFAULT_BATCH_SIZE=100
DEFAULT_MAX_CONCURRENCY=8
DEFAULT_SEED=42
